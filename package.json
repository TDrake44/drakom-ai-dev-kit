{
  "name": "@drakom/ai-dev-kit",
  "version": "0.3.0",
  "description": "An opinionated, vendor-neutral starter kit for structured AI-assisted development",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TDrake44/drakom-ai-dev-kit.git"
  },
  "homepage": "https://github.com/TDrake44/drakom-ai-dev-kit#readme",
  "bugs": {
    "url": "https://github.com/TDrake44/drakom-ai-dev-kit/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "developer-tools",
    "mcp",
    "claude-code",
    "antigravity",
    "codex",
    "copilot"
  ],
  "files": [
    "dist",
    "payload"
  ],
  "bin": {
    "drakom-ai": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs/promises').then(f=>f.chmod('dist/cli.js',0o755))\"",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "prepack": "pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-payload-version.mjs && pnpm sync",
    "typecheck": "pnpm build && tsc -p jsconfig.json",
    "test:unit": "node --test test/adoption-cli.test.mjs test/mcp-adoption.test.mjs test/release-workflow.test.mjs",
    "test:smoke": "node --test test/pack-smoke.test.mjs",
    "test": "pnpm build && pnpm run test:unit && pnpm run test:smoke",
    "sync": "pnpm build && node dist/cli.js sync .",
    "sync:check": "pnpm build && node dist/cli.js sync . --check"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/punycode": "^2.1.4",
    "typescript": "^7.0.2"
  }
}
