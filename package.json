{
  "name": "drakom-ai-dev-kit",
  "version": "0.1.0",
  "description": "An opinionated, vendor-neutral starter kit for structured AI-assisted development",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test",
    "mcp:gen": "node scripts/generate-mcp-configs.mjs",
    "mcp:check": "node scripts/generate-mcp-configs.mjs --check",
    "skills:sync": "node scripts/sync-skill-mirrors.mjs",
    "skills:check": "node scripts/sync-skill-mirrors.mjs --check",
    "verify:ai": "pnpm run mcp:check && pnpm run skills:check"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/punycode": "^2.1.4",
    "eslint": "^10.10.0",
    "js-yaml": "^4.1.0",
    "smol-toml": "^1.8.0",
    "typescript": "^7.0.2"
  }
}
